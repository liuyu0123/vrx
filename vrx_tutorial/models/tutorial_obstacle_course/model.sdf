<?xml version="1.0"?>
<sdf version="1.6">
  <model name="tutorial_obstacle_course">
    <static>true</static>

    <!-- WALL_A: blocks the left half, USV must detour to the right -->
    <link name="wall_a">
      <pose>-545 180 0.5 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <box>
            <size>30 1 3</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.4 0.0 1.0</ambient>
          <diffuse>0.9 0.4 0.0 1.0</diffuse>
          <specular>0.2 0.2 0.2 1.0</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>30 1 3</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- WALL_B: blocks the right half, USV must detour back to the left -->
    <link name="wall_b">
      <pose>-505 200 0.5 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <box>
            <size>30 1 3</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.4 0.0 1.0</ambient>
          <diffuse>0.9 0.4 0.0 1.0</diffuse>
          <specular>0.2 0.2 0.2 1.0</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>30 1 3</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- WALL_C: blocks the left half again, USV must detour to the right -->
    <link name="wall_c">
      <pose>-545 220 0.5 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <box>
            <size>30 1 3</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.4 0.0 1.0</ambient>
          <diffuse>0.9 0.4 0.0 1.0</diffuse>
          <specular>0.2 0.2 0.2 1.0</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>30 1 3</size>
          </box>
        </geometry>
      </collision>
    </link>

  </model>
</sdf>
